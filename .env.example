# DiziPush Environment Configuration
# Copy this file to .env and update values for your setup

# =============================================================================
# CORE APPLICATION
# =============================================================================
NODE_ENV=development
APP_NAME=DiziPush
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgresql://dizipush:dizipush_password@postgres:5432/dizipush
POSTGRES_USER=dizipush
POSTGRES_PASSWORD=dizipush_password
POSTGRES_DB=dizipush

# =============================================================================
# REDIS (Queues & Cache)
# =============================================================================
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption key for sensitive data (32 bytes hex)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# =============================================================================
# WEB PUSH VAPID KEYS
# =============================================================================
# Generate with: npm run generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:admin@yourdomain.com

# =============================================================================
# EMAIL (for notifications & user management)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=DiziPush <noreply@yourdomain.com>

# =============================================================================
# STORAGE (for backups, exports, uploads)
# =============================================================================
# Local storage path
STORAGE_PATH=/app/storage

# S3-compatible storage (optional)
S3_ENABLED=false
S3_ENDPOINT=
S3_BUCKET=dizipush-backups
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================
# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Tracing
JAEGER_ENABLED=false
JAEGER_ENDPOINT=http://jaeger:14268/api/traces

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
RATE_LIMIT_SKIP_SUCCESS=true

# API Rate limits
API_RATE_LIMIT_WINDOW=60
API_RATE_LIMIT_MAX=1000

# =============================================================================
# PUSH DELIVERY
# =============================================================================
# Batch sizes for delivery
PUSH_BATCH_SIZE=1000
PUSH_CONCURRENT_BATCHES=5
PUSH_RETRY_ATTEMPTS=3
PUSH_RETRY_DELAY=5000

# FCM (Firebase Cloud Messaging) - Optional
FCM_ENABLED=false
FCM_SERVER_KEY=

# =============================================================================
# DEVELOPMENT
# =============================================================================
# Hot reload
HOT_RELOAD=true

# Demo mode (creates sample data)
DEMO_MODE=true

# Debug features
DEBUG_PUSH=false
DEBUG_QUERIES=false

# =============================================================================
# PRODUCTION OVERRIDES
# =============================================================================
# SSL/TLS
FORCE_HTTPS=false
HSTS_MAX_AGE=31536000

# Session security
SECURE_COOKIES=false
SAME_SITE=lax

# CORS
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# =============================================================================
# BACKUP & MAINTENANCE
# =============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_ENABLED=false

# Cleanup old data
CLEANUP_ENABLED=true
CLEANUP_EVENTS_DAYS=90
CLEANUP_AUDIT_LOGS_DAYS=365

# =============================================================================
# EXTERNAL INTEGRATIONS
# =============================================================================
# WordPress plugin API
WP_PLUGIN_ENABLED=true

# Webhooks
WEBHOOK_TIMEOUT=30000
WEBHOOK_RETRY_ATTEMPTS=3

# Analytics
ANALYTICS_RETENTION_DAYS=365
ANALYTICS_AGGREGATION=true

# =============================================================================
# PORTS (for development)
# =============================================================================
FRONTEND_PORT=3000
BACKEND_PORT=8000
WORKER_PORT=8001
POSTGRES_PORT=5432
REDIS_PORT=6379
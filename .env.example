# Database
DATABASE_URL="postgresql://dizipush:password@localhost:5432/dizipush"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_SECRET="your-jwt-secret-key-must-be-at-least-32-chars-long"
JWT_REFRESH_SECRET="your-refresh-secret-key-must-be-at-least-32-chars-long"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Encryption (32 bytes hex - CHANGE THIS!)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# VAPID Keys for Web Push (generate with: npm run generate-vapid)
VAPID_PUBLIC_KEY="BFd5LH1sXA2R-QmWjQKsXZjD5P6F4RhLzYgL8c9MqK4Q3-vP2tQQYzRgpLFo8KxZjnZ4yPqY9kJ2Z3Rn5pJ7LgE"
VAPID_PRIVATE_KEY="F7sL4kJgZ9fQ2X3Y4zB8wP5nK1mR6tH9eC0vN7dA3sF"
VAPID_SUBJECT="mailto:admin@yourdomain.com"

# Server
NODE_ENV="development"
PORT=3001
HOST="0.0.0.0"
API_URL="http://localhost:3001"

# CORS
CORS_ORIGIN="http://localhost:3000"
CORS_CREDENTIALS="true"

# Security
FORCE_HTTPS="false"

# Logging
LOG_LEVEL="info"
LOG_FORMAT="pretty"

# Storage
STORAGE_PATH="/app/storage"
S3_ENABLED="false"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION=""

# Email (Optional)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Rate Limiting
RATE_LIMIT_WINDOW="15"
RATE_LIMIT_MAX="100"
API_RATE_LIMIT_WINDOW="60"
API_RATE_LIMIT_MAX="1000"

# Push Delivery
PUSH_BATCH_SIZE="1000"
PUSH_CONCURRENT_BATCHES="5"
PUSH_RETRY_ATTEMPTS="3"
PUSH_RETRY_DELAY="5000"

# Features
DEMO_MODE="true"
DEBUG_PUSH="true"

# Backup
BACKUP_ENABLED="true"
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS="30"

# Webhooks
WEBHOOK_TIMEOUT="30000"
WEBHOOK_RETRY_ATTEMPTS="3"
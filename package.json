{
  "name": "dizipush-monorepo",
  "version": "1.0.0",
  "description": "Self-hosted web push notification platform",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/example/dizipush.git"
  },
  "keywords": [
    "push-notifications",
    "web-push",
    "self-hosted",
    "notification-platform",
    "vapid",
    "analytics"
  ],
  "author": "DiziPush Team",
  "license": "MIT",
  "workspaces": [
    "app/frontend",
    "app/backend",
    "app/worker"
  ],
  "scripts": {
    "dev": "docker-compose -f docker-compose.dev.yml up",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "db:migrate": "cd app/backend && npm run db:migrate",
    "db:seed": "cd app/backend && npm run db:seed",
    "up": "make up",
    "down": "make down",
    "logs": "docker-compose logs -f"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  }
}
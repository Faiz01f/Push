// DiziPush Database Schema
// This file defines the complete data model for the push notification platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// USER MANAGEMENT & ORGANIZATIONS
// =============================================================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  avatar    String?
  role      UserRole @default(USER)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  ownedOrgs    Organization[] @relation("OrganizationOwner")
  memberships  Membership[]
  campaigns    Campaign[]     @relation("CampaignCreator")
  segments     Segment[]      @relation("SegmentCreator")
  auditLogs    AuditLog[]     @relation("AuditActor")

  @@map("users")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(STARTER)
  ownerId   String   @map("owner_id")
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  owner       User         @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships Membership[]
  projects    Project[]
  auditLogs   AuditLog[]

  @@map("organizations")
}

model Membership {
  id    String         @id @default(cuid())
  role  MembershipRole @default(MEMBER)
  
  userId String @map("user_id")
  orgId  String @map("org_id")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@map("memberships")
}

// =============================================================================
// PROJECTS & DOMAINS
// =============================================================================

model Project {
  id       String @id @default(cuid())
  name     String
  slug     String
  orgId    String @map("org_id")
  plan     Plan   @default(STARTER)
  features Json   @default("{}")
  settings Json   @default("{}")
  
  // VAPID Keys
  vapidPublicKey  String @map("vapid_public_key")
  vapidPrivateKey String @map("vapid_private_key")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  domains      Domain[]
  apiKeys      ApiKey[]
  subscribers  Subscriber[]
  segments     Segment[]
  campaigns    Campaign[]
  events       Event[]
  imports      Import[]
  exports      Export[]
  backups      Backup[]
  webhooks     Webhook[]

  @@unique([orgId, slug])
  @@map("projects")
}

model Domain {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  hostname  String
  verified  Boolean  @default(false)
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, hostname])
  @@map("domains")
}

model ApiKey {
  id         String   @id @default(cuid())
  projectId  String   @map("project_id")
  name       String
  keyHash    String   @unique @map("key_hash")
  scopes     String[]
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime? @map("expires_at")

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

// =============================================================================
// SUBSCRIBERS
// =============================================================================

model Subscriber {
  id       String @id @default(cuid())
  projectId String @map("project_id")
  
  // Push subscription details
  endpoint String
  p256dh   String
  auth     String
  
  // Device & Browser Info
  browser     String?
  browserVersion String? @map("browser_version")
  os          String?
  osVersion   String?  @map("os_version")
  device      String?
  deviceType  SubscriberDeviceType? @map("device_type")
  
  // Location
  country   String?
  region    String?
  city      String?
  timezone  String?
  locale    String?
  
  // Behavior
  firstSeen   DateTime @default(now()) @map("first_seen")
  lastSeen    DateTime @default(now()) @map("last_seen")
  pageViews   Int      @default(1) @map("page_views")
  
  // Status & Preferences
  status      SubscriberStatus @default(ACTIVE)
  tags        String[]
  metadata    Json             @default("{}")
  
  // Consent & Privacy
  consentAt   DateTime @default(now()) @map("consent_at")
  unsubscribedAt DateTime? @map("unsubscribed_at")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sendAttempts SendAttempt[]
  events       Event[]

  @@unique([projectId, endpoint])
  @@index([projectId, status])
  @@index([projectId, lastSeen])
  @@index([tags])
  @@map("subscribers")
}

// =============================================================================
// SEGMENTATION
// =============================================================================

model Segment {
  id         String @id @default(cuid())
  projectId  String @map("project_id")
  name       String
  definition Json   // Stores segmentation rules as JSON
  createdBy  String @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator   User       @relation("SegmentCreator", fields: [createdBy], references: [id])
  campaigns Campaign[]

  @@unique([projectId, name])
  @@map("segments")
}

// =============================================================================
// CAMPAIGNS & SCHEDULING
// =============================================================================

model Campaign {
  id        String       @id @default(cuid())
  projectId String       @map("project_id")
  name      String
  type      CampaignType @default(INSTANT)
  status    CampaignStatus @default(DRAFT)
  
  // Targeting
  segmentId String? @map("segment_id")
  
  // Message Content
  payload   Json    // Notification payload (title, body, icon, etc.)
  
  // Scheduling
  schedule  Json?   // Scheduling configuration
  
  // A/B Testing
  abTest    Json?   @map("ab_test") // A/B test configuration
  
  // Statistics (cached)
  stats     Json    @default("{}")
  
  createdBy String  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  segment      Segment?      @relation(fields: [segmentId], references: [id])
  creator      User          @relation("CampaignCreator", fields: [createdBy], references: [id])
  sends        CampaignSend[]
  sendAttempts SendAttempt[]
  events       Event[]

  @@index([projectId, status])
  @@index([projectId, type])
  @@map("campaigns")
}

model CampaignSend {
  id         String    @id @default(cuid())
  campaignId String    @map("campaign_id")
  startedAt  DateTime  @map("started_at")
  finishedAt DateTime? @map("finished_at")
  stats      Json      @default("{}")

  // Relations
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("campaign_sends")
}

model SendAttempt {
  id           String            @id @default(cuid())
  campaignId   String            @map("campaign_id")
  subscriberId String            @map("subscriber_id")
  status       SendAttemptStatus @default(PENDING)
  errorCode    String?           @map("error_code")
  errorMessage String?           @map("error_message")
  retries      Int               @default(0)
  lastAttemptAt DateTime?        @map("last_attempt_at")
  createdAt    DateTime          @default(now()) @map("created_at")

  // Relations
  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriber Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@unique([campaignId, subscriberId])
  @@index([status])
  @@index([lastAttemptAt])
  @@map("send_attempts")
}

// =============================================================================
// EVENTS & ANALYTICS
// =============================================================================

model Event {
  id           String    @id @default(cuid())
  projectId    String    @map("project_id")
  subscriberId String?   @map("subscriber_id")
  campaignId   String?   @map("campaign_id")
  type         EventType
  timestamp    DateTime  @default(now())
  metadata     Json      @default("{}")

  // Relations
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subscriber Subscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  campaign   Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([projectId, type, timestamp])
  @@index([campaignId, type])
  @@index([subscriberId, type])
  @@map("events")
}

// =============================================================================
// IMPORT/EXPORT
// =============================================================================

model Import {
  id            String      @id @default(cuid())
  projectId     String      @map("project_id")
  filename      String
  status        ImportStatus @default(PENDING)
  totalRecords  Int         @default(0) @map("total_records")
  successCount  Int         @default(0) @map("success_count")
  errorCount    Int         @default(0) @map("error_count")
  errorReport   String?     @map("error_report")
  createdAt     DateTime    @default(now()) @map("created_at")
  completedAt   DateTime?   @map("completed_at")

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("imports")
}

model Export {
  id          String      @id @default(cuid())
  projectId   String      @map("project_id")
  type        ExportType
  filename    String
  url         String?
  status      ExportStatus @default(PENDING)
  recordCount Int?        @map("record_count")
  createdAt   DateTime    @default(now()) @map("created_at")
  completedAt DateTime?   @map("completed_at")
  expiresAt   DateTime?   @map("expires_at")

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("exports")
}

// =============================================================================
// BACKUPS & WEBHOOKS
// =============================================================================

model Backup {
  id        String    @id @default(cuid())
  projectId String    @map("project_id")
  filename  String
  url       String
  size      BigInt
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime? @map("expires_at")

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("backups")
}

model Webhook {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  name      String
  url       String
  events    String[] // Event types to send
  secret    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("webhooks")
}

// =============================================================================
// AUDIT LOGGING
// =============================================================================

model AuditLog {
  id       String    @id @default(cuid())
  orgId    String    @map("org_id")
  actorId  String    @map("actor_id")
  action   String
  entity   String
  entityId String    @map("entity_id")
  diff     Json?     // Changes made
  ip       String?
  userAgent String? @map("user_agent")
  timestamp DateTime @default(now())

  // Relations
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor        User         @relation("AuditActor", fields: [actorId], references: [id])

  @@index([orgId, timestamp])
  @@index([actorId])
  @@map("audit_logs")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
}

enum MembershipRole {
  OWNER
  ADMIN
  EDITOR
  ANALYST
  MEMBER
}

enum Plan {
  STARTER
  GROWTH
  SUPERIOR
  ENTERPRISE
}

enum SubscriberStatus {
  ACTIVE
  SOFT_FAIL
  HARD_FAIL
  UNSUBSCRIBED
}

enum SubscriberDeviceType {
  DESKTOP
  MOBILE
  TABLET
}

enum CampaignType {
  INSTANT
  SCHEDULED
  RECURRING
  TRIGGERED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  PAUSED
  CANCELLED
  FAILED
}

enum SendAttemptStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  EXPIRED
}

enum EventType {
  PERMISSION_GRANTED
  PERMISSION_DENIED
  SUBSCRIBE
  UNSUBSCRIBE
  SEND
  DELIVER
  CLICK
  CLOSE
  ACTION_CLICK
  PAGE_VIEW
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ExportType {
  SUBSCRIBERS
  CAMPAIGNS
  EVENTS
  ANALYTICS
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}